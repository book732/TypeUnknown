--- !u!114 &8092754727888147889
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1706547357453941093}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c3c4ed8df843951409dcb612f56146a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hint
  _panelHint: {fileID: 0}
  _textHint: {fileID: 0}
  _textWayHint: {fileID: 0}
  _hint:
  - "\uC624\uB298\uB3C4 \uB2A6\uC5C8\uAD6C\uB098. \n\uC544\uBE60, \uB098\uB294 \uB298
    \uC5EC\uAE30\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5B4. \n\uC6B0\uB9AC\uAC00
    \uC57D\uC18D\uD588\uB358 \uADF8 \uC9D1\u2026 \uAE30\uC5B5\uD558\uC9C0?\n\uADF8\uB7EC\uB2C8\uAE4C\u2026
    \uAF2D \uB3CC\uC544\uC640"
  - "\uC9D1\uC5D0 \uAC00\uB294 \uAE38\uC774 \uC810\uC810 \uD750\uB9BF\uD574\uC838.\n\uBB38
    \uC55E\uAE4C\uC9C0 \uAC14\uB294\uB370\u2026 \uB4E4\uC5B4\uAC08 \uC218\uAC00 \uC5C6\uC5C8\uC5B4.\n\uC5F4\uC1E0\uAC00
    \uD544\uC694\uD574. \uBD84\uBA85 \uC5B4\uB514\uC5D0 \uB454 \uAC74\uB370\u2026\n\uB204\uAC00
    \uAC00\uC838\uAC04 \uAC78\uAE4C?\n\uC544\uB2C8\uBA74\u2026 \uB0B4\uAC00 \uC78A\uC5B4\uBC84\uB9B0
    \uAC78\uAE4C."
  - "\uADF8\uB0A0 \uAE30\uC5B5\uB098?\n\uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB358
    \uC778\uD615\uC744 \uAF2D \uC548\uACE0\n\uC6B0\uB9AC \uB458\uC774 \uBCA0\uB780\uB2E4\uC5D0
    \uC549\uC544\uC11C \uBCC4\uC744 \uBD24\uC796\uC544.\n\uBC14\uB78C\uC774 \uBD88\uC5B4\uC11C
    \uC870\uAE08 \uCD94\uC6E0\uB294\uB370\uB3C4\n\uC6B0\uB9B0 \uD589\uBCF5\uD588\uC5C8\uC5B4.\n\u2026\uADF8
    \uC778\uD615, \uC544\uC9C1 \uAC70\uAE30 \uC788\uC744\uAE4C?"
  - "\uC774\uC0C1\uD574\u2026\n\uBD84\uBA85 \uB0B4\uAC00 \uC606\uC5D0 \uB450\uACE0
    \uC788\uC5C8\uB294\uB370\u2026\n\uC778\uD615\uC774 \uC5C6\uC5B4\uC84C\uC5B4.\n\uC544\uBB34\uB3C4
    \uB4E4\uC5B4\uC628 \uC801 \uC5C6\uB294\uB370\u2026\n\u2026\uC5B4\uB514 \uAC04
    \uAC78\uAE4C"
  _wayHint:
  - "\uC9D1\uC774\uB77C..\uC5B4\uB514\uB97C \uB9D0\uD558\uB294\uAC70\uC9C0? \uC124\uB9C8..\uC800
    \uC5B8\uB355 \uC704\uC758 \uC800\uD0DD?"
  - "\uBB38\uC774 \uC7A0\uACA8\uC788\uB098\uBCF4\uB124.. \uC800\uD0DD\uC8FC\uBCC0
    \uD5DB\uAC04\uCABD\uC744 \uD655\uC778\uD574\uBCF4\uC790."
  - "\uBCA0\uB780\uB2E4...\uBCC4\uC744 \uBD24\uB2E4\uACE0 \uD588\uC9C0. 2\uCE35\uC77C
    \uAC00\uB2A5\uC131\uC774 \uB192\uACA0\uB124."
  - "\uC778\uD615? \uC77C\uB2E8 \uC800\uD0DD\uC744 \uB4A4\uC838\uBCF4\uB294\uAC8C
    \uC88B\uACA0\uC5B4."
  _hintIndex: 0
